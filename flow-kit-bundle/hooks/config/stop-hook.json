{
  "version": 1,
  "modules": {
    "claude-md": {
      "enabled": true,
      "auto_apply": false,
      "checks": [
        "A1",
        "A2",
        "A3",
        "A6"
      ]
    },
    "memory": {
      "enabled": true,
      "auto_apply": false,
      "checks": [
        "B1",
        "B2",
        "B4"
      ]
    },
    "git": {
      "enabled": true,
      "checks": [
        "C1",
        "C2",
        "C3",
        "C4"
      ]
    },
    "quality": {
      "enabled": true,
      "checks": [
        "D1",
        "D2",
        "D3",
        "D4"
      ]
    },
    "session": {
      "enabled": true,
      "checks": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ]
    },
    "project": {
      "enabled": true,
      "checks": [
        "F1",
        "F2",
        "F3",
        "F4",
        "F5"
      ]
    },
    "workflow": {
      "enabled": true,
      "checks": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5"
      ]
    },
    "interactive_ui_check": {
      "enabled": true,
      "checks": [
        "I1"
      ]
    },
    "weak_model_compliance": {
      "enabled": true,
      "checks": [
        "W1",
        "W2",
        "W3"
      ]
    }
  },
  "ai": {
    "enabled": true,
    "frequency": 5,
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "max_context_chars": 8000
  },
  "thresholds": {
    "claude_md_stale_days": 7,
    "large_file_bytes": 1048576,
    "branch_diverge_commits": 10,
    "report_max_age_days": 3
  },
  "output": {
    "report_file": ".claude/stop-hook-report.md",
    "suggestions_file": ".claude/stop-hook-suggestions.md",
    "terminal_summary": true,
    "max_summary_lines": 40
  },
  "session_start": {
    "remind_unreviewed": true,
    "max_reminders": 3
  }
}
