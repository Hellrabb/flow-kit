{
  "version": 1,
  "modules": {
    "claude-md": {
      "enabled": true,
      "auto_apply": false,
      "checks": [
        "A1",
        "A2",
        "A3",
        "A6"
      ]
    },
    "memory": {
      "enabled": true,
      "auto_apply": false,
      "checks": [
        "B1",
        "B2",
        "B4"
      ]
    },
    "git": {
      "enabled": true,
      "checks": [
        "C1",
        "C2",
        "C3",
        "C4"
      ]
    },
    "quality": {
      "enabled": true,
      "checks": [
        "D1",
        "D2",
        "D3",
        "D4"
      ]
    },
    "session": {
      "enabled": true,
      "checks": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ]
    },
    "project": {
      "enabled": true,
      "checks": [
        "F1",
        "F2",
        "F3",
        "F4",
        "F5"
      ]
    },
    "workflow": {
      "enabled": true,
      "checks": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5"
      ]
    },
    "interactive_ui_check": {
      "enabled": true,
      "checks": [
        "I1"
      ]
    },
    "weak_model_compliance": {
      "enabled": true,
      "checks": [
        "W1",
        "W2",
        "W3"
      ]
    },
    "flow_active_integrity": {
      "enabled": true,
      "description": ".flow-active state integrity cross-validation (L3)"
    },
    "archive_commit_check": {
      "enabled": true,
      "description": "归档后未 commit 检测 (AC-3)"
    },
    "independent_review": {
      "enabled": true,
      "checks": [
        "IR"
      ]
    }
  },
  "ai": {
    "enabled": true,
    "frequency": 5,
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "max_context_chars": 8000
  },
  "thresholds": {
    "claude_md_stale_days": 7,
    "large_file_bytes": 1048576,
    "branch_diverge_commits": 10,
    "report_max_age_days": 3
  },
  "output": {
    "report_file": ".claude/stop-hook-report.md",
    "suggestions_file": ".claude/stop-hook-suggestions.md",
    "terminal_summary": true,
    "max_summary_lines": 40
  },
  "session_start": {
    "remind_unreviewed": true,
    "max_reminders": 3
  },
  "independent_review": {
    "phases": [],
    "model": "deepseek-v4-flash",
    "_comment_max_artifact_bytes": "L3 工件截断上限，单位=字节（实现是 head -c）。CJK 工件按 ÷3 估算汉字数：80000 字节 ≈ 2.7 万汉字（约 3 万 token 量级）。**2026-09-21 由 20000 调大到 80000**（brooks-review-fix-2026-09 复核 L3 时实测：阶段 6 提示词 74610 B，20000 上限丢弃 73% 工件 → L3 据残缺工件误判「新门禁零 bats 覆盖」）。大工件项目仍应显式提高，否则 L3 只看前缀、反复报「NFR 缺失 / 锚点表被截断」假阳性。旧键 max_artifact_chars 仍可读（同按字节解释）但已废弃，会打印迁移提示。",
    "max_artifact_bytes": 80000,
    "max_failures_before_bypass": 3
  },
  "pre_tool_use_gates": {
    "independent_review": {
      "enabled": true,
      "matchers": [
        "Bash"
      ]
    }
  }
}
