             dict(title="R3.5 · 禁跳反问", color="danger", body=["阶段 0/1/2 反问 gate 未完成", "禁止产出最终方案或进入实现", "弱模型最易跳过反问直接写代码"]),
             dict(title="R6.1 · 引用前证据链", color="danger", body=["引用文件/库/API/字段/既有抽象前", "必先 grep/read 验证存在", "弱模型最高频幻觉源 = L3 证据链机制"]),
             dict(title="R7.4 · 动手前复述边界", color="danger", body=["4-dev 执行任务前必复述", "read_files / write_files 边界", "+ CHANGE 范围排除段。防 scope drift"]),
             dict(title="R1.5 · 重启协议", color="warning", body=["清窗前写 *-PROGRESS.md", "含「已排除方案」反重复段", "更新 STATE 中断字段 + 输出重启指令"]),
         ]),

    # ── 15. ADR 全景 ──
    dict(layout="standard", title="13 ADR 全景", subtitle="架构决策记录（.specs/adr/）——每次关键设计决策的背景→决策→后果",
         table=dict(
             headers=["#", "标题", "决策要点"],
             col_widths=[1, 3, 7],
             rows=[
                 ["001", "protect-the-weakest", "默认按最弱模型写，加结构刚性护栏不加唠叨；否决运行时探测（弱模型自报不可靠）"],
                 ["002", "L3 调用策略", "L3 从 Stop hook 前置到 PreToolUse（transition 点同步执行），解 L2+L3 异步死锁；超时 30s"],
                 ["003", "L2 自动派发", "curl + Anthropic API fire-and-forget 异步派 L2 agent；派发失败降级手动命令提示"],
                 ["004", "gate 返回值语义", "调用方改显式 if cmd; then exit 0; fi 判定 rc，不再依赖 || exit 0 惯例（修 BUG-A/B）"],
                 ["005", "done-validation source", "_gate_active_check source done-validation.sh（函数真正定义处）修 gate 全失效（BUG-E）"],
                 ["006", "L3 env-first", "被 ADR-012 取代：扩为三级链 + 优雅降级，L3 不再 :? 报错"],
                 ["007", "PHASE_GATE_KEY pure fn", "case 替代 declare -A，单一来源 common.sh；消除 2 处重复 declare（BUG-F 温床）"],
                 ["008", "is_git_commit 结构判定", "token 序列匹配替代正则——识 quoting/heredoc；含 heredoc 保守放行不误拦（BUG-H）"],
                 ["009", "L2-first 顺序契约", "gate_config=both 时主 agent 须先派 L2 写段，Stop 29 D4 才触发 L3（设计内，非 bug）"],
                 ["010", "_l3_check_rerun 内容标记", "mtime→hash 迁移；artifact hash 存 INDEPENDENT-REVIEW 末尾元数据行，不触 .done KVP"],
                 ["011", "G1 不 auto-advance", "pipeline scope 时不调 fk_auto_phase 写 .phase，推进权归 toll-gate（修 phase 不一致）"],
                 ["012", "L2/L3 模型三级链", "fk_resolve_model 三级优先级链 + 优雅降级（取代 006）；L2 移除 claude-sonnet-5"],
                 ["013", "correction 覆盖写", "compliance > model-missing 优先规则；单步 jq 条件 pass + mktemp 原子 mv"],
             ]),
         body=[dict(text="ADR 演进链：001 哲学基础 → 006 env-first（被 012 取代）→ 012 三级链 → 013 降级路径。每个 ADR 显式标注 Supersedes + 未来推翻条件。", size=S, color=C["muted"])]),

    # ── 16. PreToolUse + SessionStart ──
    dict(layout="standard", title="PreToolUse + SessionStart：实时拦截 + 兜底互补",
         subtitle="两条审查触发路径共享同一 l3-review.sh 编排器——PreToolUse 实时 + Stop 兜底",
         body=[
             dict(text="PreToolUse 层（每次 Bash/Write/Edit 工具调用前触发）：", bold=True, color=C["accent"], space_after=3),
             dict(text="auto-checkpoint：每次 Write/Edit 前自动写 .flow-active.interrupt（active_file + last_action + checkpoint_at）。fail-open（不阻断工具调用），全阶段 0-7 生效。", level=1, size=S),
             dict(text="independent-review-gate：path-guard 防伪造握手文件（exit 2 deny）+ handshake write 同步触发 L3 + gate_config 篡改检测 + phase write 时 .done 校验 + commit/PR 硬拦截。fail-close（gate 不通过 exit 2 deny）。", level=1, size=S),
             dict(text="两路互补：PreToolUse gate 处理正常 transition 实时拦截；Stop 29 兜底 session 异常终止时补齐。", level=1, size=S, color=C["muted"]),
             dict(text="SessionStart 层（每次新会话启动）：", bold=True, color=C["success"], space_before=4, space_after=2),
             dict(text="flow-kit-resume.sh：子 agent 隔离 gate → 向上遍历目录树找 .flow-active → 显示 ASCII art 恢复 banner（含 change_id/phase/task/goal/interrupt/token/staleness）→ 按 correction 类型分类型注入：compliance 显示违规清单（读后清）/ model-missing 提示配置（持续）/ interactive-ui-fix 注入 AskUserQuestion 调用指令（retry≥2 人工介入）/ L3 review 就绪显示 verdict+summary。", level=1, size=S),
             dict(text="stop-report-reminder.sh：提醒审阅未读 stop hook 报告（错误/警告/建议计数）≤3 次/3 天。", level=1, size=S),
         ]),

    # ── 17. 总结 ──
    dict(layout="standard", title="总结：flow-kit 的四个支柱",
         subtitle="纯 markdown 核心 · bash Hook 运行时 · Skill 包装层",
         body=[
             dict(text="① artifact-first — 阶段可压缩可回炉，关键 .md 不能缺席；状态在文件里不在对话里。", size=B, bold=True, color=C["primary"], space_after=5),
             dict(text="② protect-the-weakest — 默认按最弱模型写，结构刚性护栏兜底（R3.5/R6.1/R7.4）；Hook 自动检测跳过交互 gate + 违规 + 幻觉证据链断裂。", bold=True, color=C["primary"], space_after=5),
             dict(text="③ 三层门禁 — PCSC 自检（7 项）→ Toll-Gate 人工确认 → Transition 前置查 hook 强制；passed 依赖合法 .done 真实性校验（拒空/假/跳子进程）。", bold=True, color=C["primary"], space_after=5),
             dict(text="④ 双轮独立审查 — L2 子 agent 同步盲审 + L3 外部模型异步审查；PreToolUse 实时拦截 + Stop hook 兜底；模型由 fk_resolve_model 三级链解析，空则优雅降级不阻塞。", bold=True, color=C["primary"], space_after=5),
             dict(text="三层架构：markdown 核心不被工具更新坑到 · bash Hook 自动兜底门禁 · Skill 包装跨 IDE 一致。改哪条约定就改哪个 md。", size=S, color=C["muted"], space_before=3),
         ]),
]


def main():
    print("=== Step 1: 渲染图表 ===")
    render_diagrams.render_all()

    print("=== Step 2: 校验图表 ===")
    referenced = [s["image"] for s in SLIDES if s.get("image")]
    for img in referenced:
        p = os.path.join(render_diagrams.DIAG_DIR, img)
        assert os.path.exists(p), f"MISSING: {p}"
        r = render_diagrams.aspect_ratio(p)
        print(f"  {img}  r={r:.2f}:1  {render_diagrams.fold_verdict(r)}")

    print(f"=== Step 3: 构建 {len(SLIDES)} 张 slide ===")
    prs = Presentation()
    prs.slide_width = theme.SLIDE_W
    prs.slide_height = theme.SLIDE_H
    for i, spec in enumerate(SLIDES, 1):
        LAYOUTS[spec["layout"]](prs, spec)
        print(f"  {i:>2}  {spec['layout']:<11}  {spec.get('title','')[:42]}")

    prs.save(OUT)
    print(f"\n✅ saved: {OUT}  slides={len(prs.slides)}")
    from pptx import Presentation as P2
    P2(OUT)
    print("   P0-5 输出可重开 ✓")


if __name__ == "__main__":
    main()
